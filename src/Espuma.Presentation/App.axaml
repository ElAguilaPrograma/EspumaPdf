<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Espuma.Presentation"
             x:Class="Espuma.Presentation.App"
             Name="EspumaPdf"
             RequestedThemeVariant="Dark">
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Espuma.Presentation/Themes/Colors.axaml" />
        <ResourceInclude Source="avares://Espuma.Presentation/Themes/Icons.axaml" />
        <ResourceInclude Source="avares://Espuma.Presentation/Themes/ControlThemes.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Espuma.Presentation/Themes/Styles.axaml" />
  </Application.Styles>
</Application>
