<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="BgColor">#15171C</Color>
      <Color x:Key="SurfaceColor">#1D2027</Color>
      <Color x:Key="SurfaceHoverColor">#262A33</Color>
      <Color x:Key="BorderColor">#2F3440</Color>
      <Color x:Key="TextColor">#E3E6EC</Color>
      <Color x:Key="TextMutedColor">#9AA1AE</Color>
      <Color x:Key="AccentColor">#6FB7C9</Color>
      <Color x:Key="AccentHoverColor">#86C6D5</Color>
      <Color x:Key="AccentSoftColor">#1F3A42</Color>
      <Color x:Key="OnAccentColor">#0E1A1E</Color>
      <Color x:Key="DangerColor">#E07A7A</Color>
      <Color x:Key="DangerSoftColor">#3D2427</Color>
      <Color x:Key="SuccessColor">#7FC79A</Color>
      <Color x:Key="OverlayColor">#B3101216</Color>

      <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
      <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
      <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
      <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
      <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
      <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
      <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
      <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}" />

      <Color x:Key="SystemAccentColor">#6FB7C9</Color>
      <Color x:Key="SystemAccentColorLight1">#86C6D5</Color>
      <Color x:Key="SystemAccentColorLight2">#9ED3E0</Color>
      <Color x:Key="SystemAccentColorLight3">#B8E0EA</Color>
      <Color x:Key="SystemAccentColorDark1">#5AA3B6</Color>
      <Color x:Key="SystemAccentColorDark2">#468EA1</Color>
      <Color x:Key="SystemAccentColorDark3">#35798B</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
  <CornerRadius x:Key="RadiusMedium">10</CornerRadius>
  <CornerRadius x:Key="RadiusLarge">14</CornerRadius>
</ResourceDictionary>
