<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Espuma.Presentation.ViewModels"
             xmlns:c="using:Espuma.Presentation.Controls"
             xmlns:b="using:Espuma.Presentation.Behaviors"
             xmlns:v="using:Espuma.Presentation.Views"
             xmlns:conv="using:Espuma.Presentation.Converters"
             x:Class="Espuma.Presentation.Views.ImageToPdfView"
             x:DataType="vm:ImageToPdfViewModel">
  <c:ToolPage Icon="{Binding Descriptor.IconKey, Converter={x:Static conv:IconConverter.Instance}}"
              Title="{Binding Descriptor.Title}"
              Description="{Binding Descriptor.Description}">
    <c:ToolPage.Actions>
      <Button Classes="primary" Content="{Binding ActionText}" Command="{Binding ConvertCommand}"
              IsVisible="{Binding HasFiles}" />
    </c:ToolPage.Actions>
    <Panel>
      <c:DropZone Icon="{StaticResource Icon.Upload}" Title="{Binding DropTitle}" Hint="{Binding DropHint}"
                  Command="{Binding BrowseCommand}" FilesDroppedCommand="{Binding AddDroppedFilesCommand}"
                  VerticalAlignment="Stretch" IsVisible="{Binding !HasFiles}" />
      <DockPanel IsVisible="{Binding HasFiles}">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
          <TextBlock Classes="muted" Text="Arrastra los archivos para cambiar el orden." VerticalAlignment="Center"
                     TextWrapping="Wrap" />
          <Button Grid.Column="1" Classes="ghost" Content="Agregar más" Command="{Binding BrowseCommand}" />
          <Button Grid.Column="2" Classes="ghost" Content="Quitar todo" Command="{Binding ClearFilesCommand}" />
        </Grid>
        <Border DockPanel.Dock="Bottom" Classes="panel" Margin="0,8,0,0">
          <WrapPanel ItemSpacing="18" LineSpacing="8">
            <TextBlock Classes="label" Text="Tamaño de página" />
            <RadioButton GroupName="Layout" Content="Hoja A4, imagen ajustada" IsChecked="{Binding FitToA4}" />
            <RadioButton GroupName="Layout" Content="Tamaño original de la imagen" IsChecked="{Binding OriginalSize}" />
          </WrapPanel>
        </Border>
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Files}" ItemTemplate="{StaticResource FileItemTemplate}"
                        b:Reorder.IsEnabled="True" />
        </ScrollViewer>
      </DockPanel>
    </Panel>
  </c:ToolPage>
</UserControl>
