<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Espuma.Presentation.ViewModels"
             xmlns:s="using:Espuma.Presentation.Services"
             xmlns:c="using:Espuma.Presentation.Controls"
             xmlns:conv="using:Espuma.Presentation.Converters"
             x:Class="Espuma.Presentation.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource BgBrush}"
             Foreground="{DynamicResource TextBrush}">
  <Panel>
    <Grid ColumnDefinitions="Auto,*">
      <Border Name="Sidebar" Classes.compact="{Binding IsSidebarCompact}" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <Border.Styles>
          <Style Selector="Border#Sidebar">
            <Setter Property="Width" Value="232" />
          </Style>
          <Style Selector="Border#Sidebar.compact">
            <Setter Property="Width" Value="64" />
          </Style>
        </Border.Styles>

        <DockPanel Margin="10,16">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="6,0,0,20">
            <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource AccentBrush}">
              <c:Icon Data="{StaticResource Icon.File}" Size="18" Foreground="{DynamicResource OnAccentBrush}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="EspumaPdf" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"
                       IsVisible="{Binding !IsSidebarCompact}" />
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Spacing="2">
            <Button Classes="nav" Command="{Binding OpenRepositoryCommand}" ToolTip.Tip="Ver repositorio">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <c:Icon Data="{StaticResource Icon.ExternalLink}" Size="18" />
                <TextBlock Text="Ver repositorio" IsVisible="{Binding !IsSidebarCompact}" />
              </StackPanel>
            </Button>
            <TextBlock Classes="caption" Text="{Binding Version}" Margin="10,6,0,0"
                       IsVisible="{Binding !IsSidebarCompact}" />
          </StackPanel>

          <StackPanel Spacing="2">
            <Button Classes="nav" Classes.selected="{Binding IsHomeSelected}" Command="{Binding GoHomeCommand}"
                    ToolTip.Tip="Inicio">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <c:Icon Data="{StaticResource Icon.Home}" Size="18" />
                <TextBlock Text="Inicio" IsVisible="{Binding !IsSidebarCompact}" />
              </StackPanel>
            </Button>

            <TextBlock Classes="section" Text="HERRAMIENTAS" Margin="10,18,0,6"
                       IsVisible="{Binding !IsSidebarCompact}" />

            <ListBox Classes="nav" ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedTool}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ToolDescriptor">
                  <StackPanel Orientation="Horizontal" Spacing="12" Background="Transparent"
                              ToolTip.Tip="{Binding Title}">
                    <c:Icon Data="{Binding IconKey, Converter={x:Static conv:IconConverter.Instance}}" Size="18" />
                    <TextBlock Text="{Binding Title}"
                               IsVisible="{Binding !$parent[UserControl].((vm:MainViewModel)DataContext).IsSidebarCompact}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </DockPanel>
      </Border>

      <TransitioningContentControl Grid.Column="1" Content="{Binding CurrentPage}">
        <TransitioningContentControl.PageTransition>
          <CrossFade Duration="0:0:0.12" />
        </TransitioningContentControl.PageTransition>
      </TransitioningContentControl>
    </Grid>

    <Panel Background="{DynamicResource OverlayBrush}" IsVisible="{Binding Runner.IsBusy}">
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1" CornerRadius="{StaticResource RadiusLarge}" Padding="24" Width="360"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="{Binding Runner.Message}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
          <ProgressBar Value="{Binding Runner.Progress}" IsIndeterminate="{Binding Runner.IsIndeterminate}"
                       Minimum="0" Maximum="100" Height="6" CornerRadius="3" />
          <Button Classes="ghost" Content="Cancelar" Command="{Binding Runner.CancelCommand}"
                  HorizontalAlignment="Right" />
        </StackPanel>
      </Border>
    </Panel>

    <ItemsControl ItemsSource="{Binding Notifications.Toasts}" Margin="20"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="10" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="s:Toast">
          <Border Classes="toast" Classes.success="{Binding IsSuccess}" Classes.error="{Binding IsError}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <c:Icon Classes="kind" Data="{Binding IconKey, Converter={x:Static conv:IconConverter.Instance}}"
                      Size="20" VerticalAlignment="Top" />
              <StackPanel Grid.Column="1" Margin="12,0,8,0" Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Classes="muted" Text="{Binding Message}" TextWrapping="Wrap"
                           IsVisible="{Binding HasMessage}" />
              </StackPanel>
              <Button Grid.Column="2" Classes="icon" Command="{Binding DismissCommand}" VerticalAlignment="Top"
                      ToolTip.Tip="Cerrar">
                <c:Icon Data="{StaticResource Icon.Close}" Size="14" />
              </Button>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Panel>
</UserControl>
