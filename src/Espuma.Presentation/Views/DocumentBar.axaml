<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Espuma.Presentation.ViewModels"
             xmlns:c="using:Espuma.Presentation.Controls"
             x:Class="Espuma.Presentation.Views.DocumentBar"
             x:DataType="vm:SinglePdfToolViewModel">
  <Border Classes="panel">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
      <c:Icon Data="{StaticResource Icon.File}" Size="18" Foreground="{DynamicResource AccentBrush}"
              VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="6">
        <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="3" MinWidth="0" />
      </StackPanel>
      <Button Grid.Column="2" Classes="ghost" Content="Cambiar archivo" Command="{Binding BrowseCommand}" />
      <Button Grid.Column="3" Classes="icon danger" ToolTip.Tip="Quitar" Command="{Binding ClearFilesCommand}"
              VerticalAlignment="Center">
        <c:Icon Data="{StaticResource Icon.Close}" Size="16" />
      </Button>
    </Grid>
  </Border>
</UserControl>
