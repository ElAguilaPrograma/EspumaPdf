<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Espuma.Presentation.ViewModels"
             xmlns:c="using:Espuma.Presentation.Controls"
             xmlns:conv="using:Espuma.Presentation.Converters"
             x:Class="Espuma.Presentation.Views.ToolView"
             x:DataType="vm:ToolViewModel">
  <c:ToolPage Icon="{Binding Descriptor.IconKey, Converter={x:Static conv:IconConverter.Instance}}"
              Title="{Binding Descriptor.Title}"
              Description="{Binding Descriptor.Description}">
    <Panel>
      <c:DropZone Icon="{StaticResource Icon.Upload}" Title="{Binding DropTitle}" Hint="{Binding DropHint}"
                  Command="{Binding BrowseCommand}" FilesDroppedCommand="{Binding AddDroppedFilesCommand}"
                  VerticalAlignment="Stretch" IsVisible="{Binding !HasFiles}" />

      <DockPanel IsVisible="{Binding HasFiles}">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
          <TextBlock Classes="section" Text="ARCHIVOS" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="ghost" Content="Agregar más" Command="{Binding BrowseCommand}"
                  IsVisible="{Binding AllowMultiple}" />
          <Button Grid.Column="2" Classes="ghost" Content="Quitar todo" Command="{Binding ClearFilesCommand}" />
        </Grid>

        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Files}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SelectedFile">
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{StaticResource RadiusMedium}"
                        Padding="14,10">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <c:Icon Data="{StaticResource Icon.File}" Size="18" Foreground="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="12,0">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="caption" Text="{Binding SizeText}" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="icon danger" ToolTip.Tip="Quitar"
                            Command="{Binding $parent[UserControl].((vm:ToolViewModel)DataContext).RemoveFileCommand}"
                            CommandParameter="{Binding}">
                      <c:Icon Data="{StaticResource Icon.Close}" Size="16" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Panel>
  </c:ToolPage>
</UserControl>
