<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Espuma.Presentation.ViewModels"
             xmlns:c="using:Espuma.Presentation.Controls"
             xmlns:b="using:Espuma.Presentation.Behaviors"
             xmlns:v="using:Espuma.Presentation.Views"
             xmlns:conv="using:Espuma.Presentation.Converters"
             x:Class="Espuma.Presentation.Views.NumberPagesView"
             x:DataType="vm:NumberPagesViewModel">
  <c:ToolPage Icon="{Binding Descriptor.IconKey, Converter={x:Static conv:IconConverter.Instance}}"
              Title="{Binding Descriptor.Title}"
              Description="{Binding Descriptor.Description}">
    <c:ToolPage.Actions>
      <Button Classes="primary" Content="Numerar páginas" Command="{Binding NumberCommand}"
              IsVisible="{Binding HasDocument}" />
    </c:ToolPage.Actions>
    <Panel>
      <c:DropZone Icon="{StaticResource Icon.Upload}" Title="{Binding DropTitle}" Hint="{Binding DropHint}"
                  Command="{Binding BrowseCommand}" FilesDroppedCommand="{Binding AddDroppedFilesCommand}"
                  VerticalAlignment="Stretch" IsVisible="{Binding !HasFiles}" />
      <DockPanel IsVisible="{Binding HasFiles}">
        <v:DocumentBar DockPanel.Dock="Top" Margin="0,0,0,12" />
        <Border DockPanel.Dock="Top" Classes="panel" Margin="0,0,0,12" IsVisible="{Binding HasDocument}">
          <WrapPanel ItemSpacing="12" LineSpacing="8">
            <TextBlock Classes="label" Text="Empezar en la página" />
            <NumericUpDown Value="{Binding FirstPage}" Minimum="1" Maximum="{Binding PageCount}" Increment="1"
                           FormatString="0" ParsingNumberStyle="Integer" Width="130" />
            <TextBlock Classes="label" Text="Formato" Margin="8,0,0,0" />
            <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" MinWidth="160">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:NumberFormatOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </WrapPanel>
        </Border>
        <ScrollViewer>
          <ItemsControl Name="PageList" Classes="clickable" ItemsSource="{Binding Pages}"
                        ItemTemplate="{StaticResource PageThumbnailTemplate}" Margin="-5,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Panel>
  </c:ToolPage>
</UserControl>
